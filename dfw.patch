+}
+
+/// Invoke a guest block: read `invoke` from the block literal and call it
+/// with the block itself as the sole argument.
+pub(crate) fn invoke_block(env: &mut Environment, block: id) {
+    invoke_block_with_arg(env, block, block);
+}
+
+/// Read a little-endian u32 at a byte offset from a pointer.
+pub(crate) fn read_u32_at_byte_offset(env: &Environment, base: id, byte_offset: u32) -> u32 {
+    let byte_ptr = base.cast_const().cast::<u8>();
+    let target: ConstPtr<u32> = (byte_ptr + byte_offset).cast();
+    env.mem.read(target)
+}
+
+/// Invoke a guest block with one explicit argument (after the implicit block
+/// pointer in r0).
+pub(crate) fn invoke_block_with_arg(env: &mut Environment, block: id, arg: id) {
+    assert!(block != nil);
+    // Block literal layout (32-bit): isa(0), flags(4), reserved(8),
+    // invoke(12), descriptor(16)
+    let invoke_addr = read_u32_at_byte_offset(env, block, 12);
+    assert!(invoke_addr != 0);
+    log!(
+        "Invoking guest block {:?} (invoke at {:#x}) with arg {:?}",
+        block,
+        invoke_addr,
+        arg,
+    );
+    let guest_fn = GuestFunction::from_addr_with_thumb_bit(invoke_addr);
+    env.cpu.regs_mut()[0] = block.to_bits();
+    env.cpu.regs_mut()[1] = arg.to_bits();
+    guest_fn.call_without_pushing_stack_frame(env);
+}
+
+#[derive(Default)]
+struct OperationBase {
+    cancelled: bool,
+    executing: bool,
+    finished: bool,
+    /// `NSMutableArray*` of dependencies (retained, bookkeeping only)
+    dependencies: id,
+}
+
+enum OperationKind {
+    Base,
+    Block {
+        /// `NSMutableArray*` of block objects (`id`)
+        execution_blocks: id,
+    },
+    Invocation {
+        target: id,
+        selector: Option<SEL>,
+        object: id,
+    },
+}
+
+struct NSOperationHostObject {
+    base: OperationBase,
+    kind: OperationKind,
+}
+impl HostObject for NSOperationHostObject {}
+
+impl NSOperationHostObject {
+    fn base_new(kind: OperationKind) -> Self {
+        NSOperationHostObject {
+            base: OperationBase {
+                dependencies: nil,
+                ..Default::default()
+            },
+            kind,
+        }
+    }
+}
+
+struct NSOperationQueueHostObject {
+    /// `NSMutableArray*` of operations (bookkeeping only; we run synchronously)
+    operations: id,
+    max_concurrent: i32,
+    suspended: bool,
+    name: id,
+}
+impl HostObject for NSOperationQueueHostObject {}
