+    let host_obj = env.objc.borrow_mut::<NSOperationHostObject>(this);
+    match &mut host_obj.kind {
+        OperationKind::Block { execution_blocks } => *execution_blocks = blocks,
+        _ => panic!("NSBlockOperation init on non-block operation"),
