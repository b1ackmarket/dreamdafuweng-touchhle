+// ARM EABI integer division/modulo helpers (compiler-rt builtins).
+// The Rust function names have two leading underscores so that
+// `export_c_func!` (which prepends one more) produces the correct
+// three-underscore Mach-O symbols (e.g. `___modsi3`).
+fn __modsi3(_env: &mut Environment, a: i32, b: i32) -> i32 {
+    a % b
+}
+fn __divsi3(_env: &mut Environment, a: i32, b: i32) -> i32 {
+    a / b
+}
+fn __umodsi3(_env: &mut Environment, a: u32, b: u32) -> u32 {
+    a % b
