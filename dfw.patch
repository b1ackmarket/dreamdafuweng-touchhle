+- (id)initWithTarget:(id)target selector:(SEL)selector object:(id)object {
+    retain(env, target);
+    retain(env, object);
+    let host_obj = env.objc.borrow_mut::<NSOperationHostObject>(this);
+    match &mut host_obj.kind {
+        OperationKind::Invocation {
+            target: t,
+            selector: s,
+            object: o,
+        } => {
+            *t = target;
+            *s = Some(selector);
