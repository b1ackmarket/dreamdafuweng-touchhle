+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Grand Central Dispatch (`/usr/lib/system/libdispatch.dylib`).
+//!
+//! Minimal implementation: `dispatch_once`.
+
+use crate::dyld::{export_c_func, FunctionExports};
+use crate::frameworks::foundation::ns_operation_queue::invoke_block;
+use crate::mem::{MutPtr, MutVoidPtr};
+use crate::objc::id;
+use crate::Environment;
+
+fn dispatch_once(env: &mut Environment, predicate: MutPtr<i32>, block: id) {
+    log!("dispatch_once(predicate={:?}, block={:?})", predicate, block);
+    // Sanity check: block should be a valid user-space pointer.
+    // If it's clearly invalid (e.g., kernel space address), skip.
+    let block_addr = block.to_bits();
+    if block_addr >= 0xFFFF0000 {
+        log!("Warning: dispatch_once called with invalid block {:?}, skipping", block);
+        // Still mark predicate as done to avoid infinite loop
+        env.mem.write(predicate.cast(), -1i32);
+        return;
+    }
+    // dispatch_once_t is a long (4 bytes on 32-bit)
+    let done: i32 = env.mem.read(predicate.cast());
+    if done == 0 {
+        log_dbg!("dispatch_once({:?}): executing block {:?}", predicate, block);
+        invoke_block(env, block);
+        env.mem.write(predicate.cast(), -1i32);
+    } else {
+        log_dbg!("dispatch_once({:?}): already executed", predicate);
+    }
+}
+
+pub const FUNCTIONS: FunctionExports = &[export_c_func!(dispatch_once(_, _))];
