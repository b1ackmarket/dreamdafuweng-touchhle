+- (())addOperation:(id)op {
+    assert!(op != nil);
+    log_dbg!("[NSOperationQueue addOperation:{:?}] (executing synchronously)", op);
+    let ops = env.objc.borrow::<NSOperationQueueHostObject>(this).operations;
+    if ops != nil {
