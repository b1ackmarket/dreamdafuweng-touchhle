+++ b/src/frameworks/foundation/ns_block.rs
@@ -0,0 +1,53 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Block classes (`_NSConcreteStackBlock`, etc.).
+//!
+//! These are the isa classes for Objective-C block literals. They need to
+//! exist so that blocks are valid objects (e.g. can receive `retain`).
+//! Blocks are created by the compiler as literals, never via `alloc`, so no
+//! allocation methods are needed; everything else is inherited from
+//! `NSObject`, except memory management which is a no-op: we execute blocks
+//! synchronously, so stack blocks stay valid for the duration of use, and
+//! global blocks are immortal anyway.
+
+use crate::objc::{id, objc_classes, ClassExports};
+use crate::Environment;
+
+pub const CLASSES: ClassExports = objc_classes! {
+
+(env, this, _cmd);
+
+@implementation NSBlock: NSObject
+
+- (id)retain {
+    // No-op: blocks are not tracked in the host object map.
+    // Stack blocks are valid for the synchronous duration of use;
+    // global blocks are immortal.
+    this
+}
+- (())release {
+    // No-op (see above).
+}
+- (id)autorelease {
+    this
+}
+- (id)copy {
+    // For our synchronous use, retaining (no-op) is sufficient.
+    this
+}
+
+@end
+
+@implementation _NSConcreteStackBlock: NSBlock
+@end
+
+@implementation _NSConcreteGlobalBlock: NSBlock
+@end
+
+@implementation _NSConcreteMallocBlock: NSBlock
+@end
+
+};
