+
+- (())addExecutionBlock:(id)block {
+    assert!(block != nil);
+    // We execute synchronously and immediately, so the (possibly stack)
+    // block is still valid; a retain is enough, no _Block_copy needed.
+    retain(env, block);
+    let host_obj = env.objc.borrow::<NSOperationHostObject>(this);
+    let blocks = match &host_obj.kind {
+        OperationKind::Block { execution_blocks } => *execution_blocks,
+        _ => panic!("addExecutionBlock: on non-block operation"),
+    };
