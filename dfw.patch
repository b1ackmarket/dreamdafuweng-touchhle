+    let cancelled = env.objc.borrow::<NSOperationHostObject>(this).base.cancelled;
+    if !cancelled {
+        env.objc.borrow_mut::<NSOperationHostObject>(this).base.executing = true;
+        () = msg![env; this main];
+        let base = &mut env.objc.borrow_mut::<NSOperationHostObject>(this).base;
+        base.executing = false;
+        base.finished = true;
+    } else {
+        env.objc.borrow_mut::<NSOperationHostObject>(this).base.finished = true;
+    }
+}
+
+- (())main {
+    // Default implementation does nothing; subclasses override.
+}
+
+- (bool)isCancelled {
+    env.objc.borrow::<NSOperationHostObject>(this).base.cancelled
+}
+- (())cancel {
+    env.objc.borrow_mut::<NSOperationHostObject>(this).base.cancelled = true;
+}
+- (bool)isExecuting {
+    env.objc.borrow::<NSOperationHostObject>(this).base.executing
+}
+- (bool)isFinished {
+    env.objc.borrow::<NSOperationHostObject>(this).base.finished
+}
+- (bool)isConcurrent {
+    // We always run operations synchronously.
+    false
+}
+- (bool)isAsynchronous {
+    false
+}
+- (bool)isReady {
+    // Dependencies are ignored; always ready.
+    true
