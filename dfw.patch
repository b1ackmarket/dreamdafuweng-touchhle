diff --git a/src/frameworks/core_foundation/cf_uuid.rs b/src/frameworks/core_foundation/cf_uuid.rs
index 5ece4ff..a6706d3 100644
--- a/src/frameworks/core_foundation/cf_uuid.rs
+++ b/src/frameworks/core_foundation/cf_uuid.rs
@@ -56,7 +56,47 @@ fn CFUUIDCreateString(
     from_rust_string(env, uuid_str)
 }
 
+// CFUUIDBytes is a 16-byte struct returned by value.
+// On ARM, it's returned in r0-r3. We model it as a 16-byte array.
+// The export_c_func! macro needs to handle struct returns; for simplicity,
+// we return the bytes via a guest-allocated buffer? No - we need to return
+// by value. Let's use a custom approach: the function returns a u64 pair?
+// Actually, for ARM, a 16-byte struct is returned in r0-r3 (4 words).
+// We'll define the function to return [u8; 16] and hope the ABI works.
+// Simpler: return the UUID bytes as two u64s? No.
+//
+// The cleanest: use the `export_c_func!` with a return type that the
+// calling convention handles. For a 16-byte struct, Rust's [u8; 16]
+// should map correctly to r0-r3 on ARM.
+
+fn CFUUIDGetUUIDBytes(env: &mut Environment, uuid: CFUUIDRef) -> [u8; 16] {
+    let host_object = env.objc.borrow::<CFUUIDHostObject>(uuid);
+    *host_object.uuid.as_bytes()
+}
+
+// CFUUIDBytes (16 bytes) is returned in r0-r3 on ARM.
+impl crate::abi::GuestRet for [u8; 16] {
+    fn from_regs(regs: &[u32]) -> Self {
+        let mut bytes = [0u8; 16];
+        for i in 0..4 {
+            bytes[i * 4..(i + 1) * 4].copy_from_slice(&regs[i].to_le_bytes());
+        }
+        bytes
+    }
+    fn to_regs(self, regs: &mut [u32]) {
+        for i in 0..4 {
+            regs[i] = u32::from_le_bytes([
+                self[i * 4],
+                self[i * 4 + 1],
+                self[i * 4 + 2],
+                self[i * 4 + 3],
+            ]);
+        }
+    }
+}
+
 pub const FUNCTIONS: FunctionExports = &[
     export_c_func!(CFUUIDCreate(_)),
     export_c_func!(CFUUIDCreateString(_, _)),
+    export_c_func!(CFUUIDGetUUIDBytes(_)),
 ];
