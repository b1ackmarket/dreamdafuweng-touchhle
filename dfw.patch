+//! CommonCrypto (`/usr/lib/system/libcommonCrypto.dylib`).
+//!
+//! Minimal implementation: HMAC (MD5/SHA1/SHA256) and one-shot hashes.
+
+use crate::dyld::{export_c_func, FunctionExports};
+use crate::mem::{ConstVoidPtr, GuestUSize, MutVoidPtr};
+use crate::Environment;
+use std::collections::HashMap;
+
+// CCHmacAlgorithm values
+const K_CC_HMAC_ALG_SHA1: u32 = 0;
+const K_CC_HMAC_ALG_MD5: u32 = 1;
+const K_CC_HMAC_ALG_SHA256: u32 = 2;
+
+#[derive(Default)]
+pub struct State {
+    hmac_contexts: HashMap<u32, HmacState>,
+}
+impl State {
+    fn get(env: &mut Environment) -> &mut Self {
+        &mut env.libc_state.common_crypto
+    }
+}
+
+struct HmacState {
+    algorithm: u32,
+    key: Vec<u8>,
+    data: Vec<u8>,
+}
+
+fn CCHmacInit(
+    env: &mut Environment,
+    ctx: MutVoidPtr,
+    algorithm: u32,
+    key: ConstVoidPtr,
+    key_length: u32,
+) {
+    let key_bytes = env
+        .mem
+        .bytes_at(key.cast(), key_length as GuestUSize)
+        .to_vec();
+    log_dbg!(
+        "CCHmacInit({:?}, alg={}, key_len={})",
+        ctx,
+        algorithm,
+        key_length
+    );
+    State::get(env).hmac_contexts.insert(
+        ctx.to_bits(),
+        HmacState {
+            algorithm,
+            key: key_bytes,
+            data: Vec::new(),
+        },
+    );
+}
+
+fn CCHmacUpdate(env: &mut Environment, ctx: MutVoidPtr, data: ConstVoidPtr, data_length: u32) {
+    let data_bytes = env
+        .mem
+        .bytes_at(data.cast(), data_length as GuestUSize)
+        .to_vec();
+    log_dbg!("CCHmacUpdate({:?}, len={})", ctx, data_length);
+    let state = State::get(env)
+        .hmac_contexts
+        .get_mut(&ctx.to_bits())
+        .expect("CCHmacUpdate on unknown context");
+    state.data.extend_from_slice(&data_bytes);
+}
+
+fn CCHmacFinal(env: &mut Environment, ctx: MutVoidPtr, mac_out: MutVoidPtr) {
+    log_dbg!("CCHmacFinal({:?})", ctx);
+    let state = State::get(env)
+        .hmac_contexts
+        .remove(&ctx.to_bits())
+        .expect("CCHmacFinal on unknown context");
+    let result = hmac_compute_manual(state.algorithm, &state.key, &state.data);
+    env.mem
+        .bytes_at_mut(mac_out.cast(), result.len() as GuestUSize)
+        .copy_from_slice(&result);
+}
+
+// Manual HMAC implementation to avoid the hmac crate dependency.
+fn hmac_compute_manual(algorithm: u32, key: &[u8], data: &[u8]) -> Vec<u8> {
+    use digest::Digest;
+    let (block_size, hash_fn): (usize, Box<dyn Fn(&[u8]) -> Vec<u8>>) = match algorithm {
+        K_CC_HMAC_ALG_MD5 => (
+            64,
+            Box::new(|d| {
+                let mut h = md5::Md5::new();
+                h.update(d);
+                h.finalize().to_vec()
+            }),
+        ),
+        K_CC_HMAC_ALG_SHA1 => (
+            64,
+            Box::new(|d| {
+                let mut h = sha1::Sha1::new();
+                h.update(d);
+                h.finalize().to_vec()
+            }),
+        ),
+        K_CC_HMAC_ALG_SHA256 => (
+            64,
+            Box::new(|d| {
+                let mut h = sha2::Sha256::new();
+                h.update(d);
+                h.finalize().to_vec()
+            }),
+        ),
+        _ => panic!("Unsupported HMAC algorithm {}", algorithm),
+    };
+
+    // HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m))
+    let mut key_block = vec![0u8; block_size];
+    if key.len() > block_size {
+        let hashed = hash_fn(key);
+        key_block[..hashed.len()].copy_from_slice(&hashed);
+    } else {
+        key_block[..key.len()].copy_from_slice(key);
+    }
+    let mut ipad = vec![0x36u8; block_size];
+    let mut opad = vec![0x5cu8; block_size];
+    for i in 0..block_size {
+        ipad[i] ^= key_block[i];
+        opad[i] ^= key_block[i];
+    }
+    let mut inner = ipad;
+    inner.extend_from_slice(data);
+    let inner_hash = hash_fn(&inner);
+    let mut outer = opad;
+    outer.extend_from_slice(&inner_hash);
+    hash_fn(&outer)
+}
+
+fn CC_MD5(env: &mut Environment, data: ConstVoidPtr, len: u32, md: MutVoidPtr) -> MutVoidPtr {
+    use digest::Digest;
+    let bytes = env.mem.bytes_at(data.cast(), len as GuestUSize);
+    let mut hasher = md5::Md5::new();
+    hasher.update(bytes);
+    let result = hasher.finalize();
+    env.mem
+        .bytes_at_mut(md.cast(), result.len() as GuestUSize)
+        .copy_from_slice(&result);
+    md
+}
+
+fn CC_SHA1(env: &mut Environment, data: ConstVoidPtr, len: u32, md: MutVoidPtr) -> MutVoidPtr {
+    use digest::Digest;
+    let bytes = env.mem.bytes_at(data.cast(), len as GuestUSize);
+    let mut hasher = sha1::Sha1::new();
+    hasher.update(bytes);
+    let result = hasher.finalize();
+    env.mem
+        .bytes_at_mut(md.cast(), result.len() as GuestUSize)
+        .copy_from_slice(&result);
+    md
+}
+
+fn CC_SHA256(env: &mut Environment, data: ConstVoidPtr, len: u32, md: MutVoidPtr) -> MutVoidPtr {
+    use digest::Digest;
+    let bytes = env.mem.bytes_at(data.cast(), len as GuestUSize);
+    let mut hasher = sha2::Sha256::new();
+    hasher.update(bytes);
+    let result = hasher.finalize();
+    env.mem
+        .bytes_at_mut(md.cast(), result.len() as GuestUSize)
+        .copy_from_slice(&result);
+    md
+}
+
+pub const FUNCTIONS: FunctionExports = &[
+    export_c_func!(CCHmacInit(_, _, _, _)),
+    export_c_func!(CCHmacUpdate(_, _, _)),
+    export_c_func!(CCHmacFinal(_, _)),
+    export_c_func!(CC_MD5(_, _, _)),
+    export_c_func!(CC_SHA1(_, _, _)),
+    export_c_func!(CC_SHA256(_, _, _)),
+];
